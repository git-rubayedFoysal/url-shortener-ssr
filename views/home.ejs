<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <% if (locals.user) { %>
        <a class="logout" href="/logout">Logout</a>
        <% } %>
    <div class="container">
        <div class="header">
            <h1>URL Shortener</h1>
        </div>
        <form action="/url" method="post">
            <div class="url-container">
                <label for="url">Enter Original Url: </label>
                <input type="text" name="url" id="url" placeholder="https://www.example.com">
            </div>

            <button type="submit">Generate</button>
        </form>

        <% if (locals.id) { %>
            <div class="output">
                <h3>Generated Short Url:
                    <a target="_blank" href="/url/<%= locals.id %>">
                        http://localhost:8001/url/<%= locals.id %>
                    </a>
                </h3>

                <a class="return" href="/">Return Home</a>
            </div>
            <% } %>

                <% if (locals.auth===false) { %>
                    <div class="output auth-required">
                        <h3>
                            Authentication Required For Show URLS.
                            <a class="login" href="/login">Login Here</a>
                        </h3>

                    </div>
                    <% } %>


                        <% if(locals.urls) { %>
                            <div id="analytics">
                                <% if(locals.urls.length> 0){ %>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>Sl. No</th>
                                                <th>ShortID</th>
                                                <th>Redirect</th>
                                                <th>Clicks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% urls.forEach((url, index)=> { %>
                                                <tr>
                                                    <td>
                                                        <%=index +1 %>
                                                    </td>
                                                    <td>
                                                        <%= url.shortId %>
                                                    </td>
                                                    <td title="<%= url.redirectUrl %>">
                                                        <%= url.redirectUrl %>
                                                    </td>
                                                    <td>
                                                        <%= url.visitedHistory.length %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                    <% } else {%>
                                        <div class="empty-state">
                                            <h3>No URLs yet</h3>
                                            <p>You haven't created any URLs yet. Create your first short URL to get
                                                started!</p>
                                        </div>
                                        <% } %>
                            </div>
                            <% } %>
    </div>
</body>

</html>